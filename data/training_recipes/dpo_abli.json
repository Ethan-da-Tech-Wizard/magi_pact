{
  "recipe_id": "lora-dpo-rtx3070-v1",
  "base_model": "abliterated://qwen-coder-32b-abli-mac",
  "is_abliterated": true,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "rank": 16,
  "alpha": 32,
  "learning_rate": 5e-05,
  "beta": 0.1,
  "lr_scheduler": "cosine",
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "optimizer": "paged_adamw_8bit",
  "gradient_checkpointing": true,
  "max_seq_length": 2048,
  "max_prompt_length": 1024,
  "max_target_length": 1024,
  "lora_dropout": 0.05,
  "load_in_4bit": true,
  "quant_type": "nf4",
  "use_double_quant": true,
  "torch_dtype": "bfloat16",
  "dataset_path": "data/datasets/golden_multilang_corpus.jsonl",
  "sft_adapter_path": "exchange/adapters/sft",
  "output_dir": "exchange/adapters/dpo",
  "epochs": 2
}